<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TaskbarQuota.Controls.TotalSpendControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:TaskbarQuota.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel
            x:Name="RootCard"
            Spacing="16"
            Visibility="{x:Bind ViewModel.HasSpendData, Mode=OneWay}">

        <!-- Container 1: period selector + summary ring -->
        <Border x:Name="Container1Card"
            Padding="20,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Cost"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="CostRefreshButton"
                            AutomationProperties.AutomationId="RefreshUsageHeaderButton"
                            AutomationProperties.Name="Refresh usage"
                            Command="{x:Bind RefreshCommand}"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CostShareButton"
                            AutomationProperties.AutomationId="ShareCostButton"
                            AutomationProperties.Name="Share cost summary"
                            ToolTipService.ToolTip="Share cost summary as an image"
                            Click="CostShareButton_Click"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72D;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <muxc:SelectorBar
                    x:Name="PeriodBar"
                    AutomationProperties.AutomationId="UsagePeriodSelector"
                    AutomationProperties.Name="Usage reporting period"
                    HorizontalAlignment="Left"
                    SelectionChanged="PeriodBar_SelectionChanged">
                    <muxc:SelectorBarItem Tag="1" Text="1 day" />
                    <muxc:SelectorBarItem Tag="7" Text="7 days" />
                    <muxc:SelectorBarItem Tag="30" Text="30 days" />
                    <muxc:SelectorBarItem Tag="90" Text="90 days" />
                </muxc:SelectorBar>

                <Grid x:Name="SummaryGrid" ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="SpendRingHost"
                        AutomationProperties.AutomationId="SpendSummaryRing"
                        AutomationProperties.Name="{x:Bind ViewModel.RingAutomationName, Mode=OneWay}"
                        Width="160"
                        Height="160"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RingTooltip, Mode=OneWay}">
                        <Canvas
                            x:Name="SpendRingCanvas"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SizeChanged="SpendRingCanvas_SizeChanged" />
                        <StackPanel
                            Width="104"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.RingCenterValue, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.RingCenterUnit, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Provider summary" />
                            <muxc:SelectorBar
                                x:Name="MetricBar"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="UsageMetricSelector"
                                AutomationProperties.Name="Summary metric"
                                SelectionChanged="MetricBar_SelectionChanged">
                                <muxc:SelectorBarItem Tag="cost" Text="Cost" />
                                <muxc:SelectorBarItem Tag="tokens" Text="Tokens" />
                            </muxc:SelectorBar>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.HeadlineDetail, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ProviderSlices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TotalSpendSliceViewModel">
                                    <Grid Margin="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind DotBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProviderName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind SummaryValueText}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ShareText}" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Container 2: daily cost chart + token stats -->
        <Border x:Name="Container2Card"
            Padding="20,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="16">
                <StackPanel x:Name="DailyChartSection" Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}" />
                    <Border
                        Padding="8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Canvas
                            x:Name="UsageChartCanvas"
                            AutomationProperties.AutomationId="DailyUsageChart"
                            AutomationProperties.Name="Daily usage by provider"
                            Height="176"
                            HorizontalAlignment="Stretch"
                            SizeChanged="UsageChartCanvas_SizeChanged" />
                    </Border>
                </StackPanel>

                <Grid x:Name="TokenMetricsSection" ColumnSpacing="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="2">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Processed tokens" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.TotalTokensText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.TotalTokensDetail, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="2">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Cached input" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CachedInputText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CachedInputDetail, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="2">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Uncached input" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.UncachedInputText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.UncachedInputDetail, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="2">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Output" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.OutputText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.OutputDetail, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="2">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Cache savings" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CacheSavingsText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CacheSavingsDetail, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Container 3: usage breakdown -->
        <Border x:Name="Container3Card"
            Padding="20,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel x:Name="BreakdownSection" Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Breakdown" />
                    <muxc:SelectorBar
                        x:Name="BreakdownBar"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="UsageBreakdownSelector"
                        AutomationProperties.Name="Usage breakdown"
                        SelectionChanged="BreakdownBar_SelectionChanged">
                        <muxc:SelectorBarItem Tag="model" Text="Model" />
                        <muxc:SelectorBarItem Tag="day" Text="Day" />
                    </muxc:SelectorBar>
                </Grid>

                <StackPanel Visibility="{x:Bind ViewModel.ModelBreakdownVisibility, Mode=OneWay}">
                    <Grid Padding="0,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Model" />
                        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Cost" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Share" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Tokens" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ModelItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CombinedModelUsageItemViewModel">
                                <Grid Padding="0,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind ModelName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ProviderName}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind CostText}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ShareText}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TokensText}" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{x:Bind ViewModel.DayBreakdownVisibility, Mode=OneWay}">
                    <Grid Padding="0,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Day" />
                        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Cost" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Tokens" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DayItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CombinedDayUsageItemViewModel">
                                <Grid Padding="0,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DayText}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CostText}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TokensText}" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

            <muxc:TeachingTip x:Name="ShareTip"
                              PreferredPlacement="Bottom"
                              IsLightDismissEnabled="True" />
        </StackPanel>

        <StackPanel
            Visibility="{x:Bind ViewModel.IsLoadingVisibility, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,48,0,0"
            Spacing="10">
            <ProgressRing
                IsActive="True"
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock
                Text="Reading usage history…"
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock
            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
            Text="No local usage history found"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,48,0,0"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
