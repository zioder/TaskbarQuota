<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TaskbarQuota.Controls.StarPromptBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            HorizontalAlignment="Stretch">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0"
                      Glyph="&#xE735;"
                      FontSize="16"
                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                      VerticalAlignment="Center"/>

            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Text="Enjoying TaskbarQuota?"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <Button x:Name="StarButton"
                    Grid.Column="2"
                    MinWidth="96"
                    VerticalAlignment="Center"
                    Click="StarButton_Click"
                    AutomationProperties.AutomationId="FlyoutStarOnGitHubButton"
                    Content="Star it"
                    Style="{StaticResource AccentButtonStyle}"/>

            <Button x:Name="DismissButton"
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="DismissButton_Click"
                    AutomationProperties.AutomationId="FlyoutDismissStarPromptButton"
                    AutomationProperties.Name="Dismiss star prompt"
                    ToolTipService.ToolTip="Don't ask again"
                    Background="Transparent"
                    BorderThickness="0">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
