<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TaskbarQuota</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppxManifest>Package.appxmanifest</AppxManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Custom Program.Main enforces a single instance; see Program.cs -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Unpackaged, self-contained so it runs without prerequisites and can inject into the taskbar -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <!-- Loose .xbf beside the exe; required for unpackaged publish (embedded-only Release PRI was not copied). -->
    <DisableEmbeddedXbf>true</DisableEmbeddedXbf>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>

    <Product>TaskbarQuota</Product>
    <AssemblyName>TaskbarQuota</AssemblyName>
    <ApplicationIcon>Assets\TaskBarQuota.ico</ApplicationIcon>
    <Version>1.3.2</Version>
    <AssemblyVersion>1.3.2.0</AssemblyVersion>
    <FileVersion>1.3.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\TaskBarQuota.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\TaskBarQuota.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- MSIX Store logo assets (referenced by Package.appxmanifest) -->
    <Content Include="Assets\StoreLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square150x150Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Pricing\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon" Version="2.0.131" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Override Microsoft.Data.Sqlite's vulnerable 2.1.11 native bundle (CVE-2025-6965). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskbarQuota.Tests" />
  </ItemGroup>

  <!--
    The XAML compiler emits loose .xbf files as part of the build. They are not
    represented by project items, so collecting them during AssignTargetPaths
    happens before the files exist in a clean dotnet publish. Copy them after
    Publish has built the app and produced the final publish directory.
  -->
  <Target Name="AddLooseXbfToPublish"
          Condition="'$(WindowsPackageType)' == 'None' and '$(PublishDir)' != ''"
          AfterTargets="Publish">
    <ItemGroup>
      <_LooseXbf Include="$(TargetDir)**\*.xbf"
                 Exclude="$(TargetDir)publish\**\*.xbf;$(PublishDir)**\*.xbf" />
    </ItemGroup>

    <Error Condition="'@(_LooseXbf)' == ''"
           Text="No loose XBF files were generated in '$(TargetDir)'. Unpackaged WinUI publish cannot start without them." />
    <Copy SourceFiles="@(_LooseXbf)"
          DestinationFiles="@(_LooseXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddWindowsAppRuntimeNotificationResourceToPublish"
          Condition="'$(WindowsPackageType)' == 'None'
                     and '$(WindowsAppSDKSelfContained)' == 'true'
                     and ('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64')"
          AfterTargets="Publish">
    <PropertyGroup>
      <_WindowsAppRuntimeArchitecture Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</_WindowsAppRuntimeArchitecture>
      <_WindowsAppRuntimeArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</_WindowsAppRuntimeArchitecture>
      <_WindowsAppRuntimeExtractDir>$(IntermediateOutputPath)WindowsAppRuntimeNotificationResource\$(_WindowsAppRuntimeArchitecture)</_WindowsAppRuntimeExtractDir>
      <_WindowsAppRuntimeNotificationResource>$(_WindowsAppRuntimeExtractDir)\Microsoft.WindowsAppRuntime.Insights.Resource.dll</_WindowsAppRuntimeNotificationResource>
    </PropertyGroup>
    <ItemGroup>
      <_WindowsAppRuntimeMsix Include="$(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(_WindowsAppRuntimeArchitecture)\Microsoft.WindowsAppRuntime.*.msix"
                             Exclude="$(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(_WindowsAppRuntimeArchitecture)\Microsoft.WindowsAppRuntime.DDLM.*.msix;
                                      $(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(_WindowsAppRuntimeArchitecture)\Microsoft.WindowsAppRuntime.Main.*.msix;
                                      $(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(_WindowsAppRuntimeArchitecture)\Microsoft.WindowsAppRuntime.Singleton.*.msix" />
    </ItemGroup>
    <Error Condition="'@(_WindowsAppRuntimeMsix->Count())' != '1'"
           Text="Expected exactly one Windows App Runtime MSIX for $(_WindowsAppRuntimeArchitecture) under the restored Microsoft.WindowsAppSDK.Runtime package at '$(MicrosoftWindowsAppSDKPackageDir)', found @(_WindowsAppRuntimeMsix->Count())." />
    <RemoveDir Directories="$(_WindowsAppRuntimeExtractDir)" />
    <MakeDir Directories="$(_WindowsAppRuntimeExtractDir)" />
    <Exec Command="&quot;$(MakeAppxExeFullPath)&quot; unpack /p &quot;@(_WindowsAppRuntimeMsix)&quot; /d &quot;$(_WindowsAppRuntimeExtractDir)&quot; /o"
          StandardOutputImportance="Low" />
    <Error Condition="!Exists('$(_WindowsAppRuntimeNotificationResource)')"
           Text="Microsoft.WindowsAppRuntime.Insights.Resource.dll was not found in '@(_WindowsAppRuntimeMsix)'." />
    <Copy SourceFiles="$(_WindowsAppRuntimeNotificationResource)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(_WindowsAppRuntimeExtractDir)" />
  </Target>
</Project>
